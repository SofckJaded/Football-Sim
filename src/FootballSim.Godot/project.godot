; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FootballSimulation"
run/main_scene="res://MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
; Frame pacing: the simulation advances on a fixed 60 Hz tick and renders between ticks, so a 120 FPS
; cap gives every tick two evenly spaced frames at a steady cadence without burning a full uncapped
; frame rate. Vsync is off because the reference display is 180 Hz - with vsync on the engine would be
; paced to 180 Hz and the 120 cap would produce uneven 1/2-vblank spacing instead of a clean 120.
run/max_fps=120

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="FootballSim.Godot"

[physics]

common/enable_object_picking=false

[rendering]

; docs/football-grass.md §5.5 / G2.5: SMAA by default. The analytic markings SDF uses
; coverage-preserving fwidth AA, stripes are feathered and the ground raises its roughness as the
; detail normals fade, so SMAA stays shimmer-free without TAA's ~0.8 ms cost or capsule ghosting.
; TAA remains an A/B contender in the bench harness only.
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/screen_space_roughness_limiter/enabled=true
